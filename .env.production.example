APP_NAME=AI Ops Monitor
APP_ENV=production
DEBUG=false
LOG_SQL=false

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB_NAME
REDIS_URL=redis://USER:PASSWORD@HOST:6379/0
CELERY_BROKER_URL=redis://USER:PASSWORD@HOST:6379/0
CELERY_RESULT_BACKEND=redis://USER:PASSWORD@HOST:6379/0

GEMINI_API_KEY=replace-with-provider-secret
GEMINI_MODEL=gemini-2.5-flash
MONITORING_INTERVAL_SECONDS=60

SECRET_KEY=replace-with-a-random-value-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
CORS_ORIGINS=https://your-frontend-domain.example

NEXT_PUBLIC_API_URL=https://your-backend-domain.example
NEXT_PUBLIC_WS_URL=wss://your-backend-domain.example/ws
